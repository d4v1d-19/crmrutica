{
  "version": 1,
  "sdk_version": "3.0.5",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://yuqnsardvxeaemnsxpxf.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "customer-connection-hub",
      "version": "0.1.0",
      "title": "Customer Connection Hub"
    },
    "tools": [
      {
        "name": "list_clients",
        "title": "Listar clientes",
        "description": "Lista clientes de Rutica CRM (máx. 100), con filtros opcionales por estado, medida de interés y canal.",
        "annotations": {
          "readOnlyHint": true
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "estado": {
              "type": "string",
              "enum": [
                "potencial",
                "oficial"
              ]
            },
            "medida_interes": {
              "type": "string",
              "enum": [
                "frio",
                "tibio",
                "caliente"
              ]
            },
            "canal": {
              "type": "string",
              "enum": [
                "WhatsApp",
                "Correo electrónico",
                "Redes sociales",
                "Llamada telefónica",
                "Formulario",
                "Otro"
              ]
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "create_client",
        "title": "Crear cliente",
        "description": "Crea un cliente en Rutica CRM. El canal es obligatorio (por defecto 'Otro'); 'Formulario' no está permitido. El agente asignado es el usuario que llama.",
        "annotations": {
          "readOnlyHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "email": {
              "type": "string",
              "format": "email",
              "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
            },
            "phone": {
              "type": "string"
            },
            "company": {
              "type": "string"
            },
            "canal": {
              "default": "Otro",
              "type": "string",
              "enum": [
                "WhatsApp",
                "Correo electrónico",
                "Redes sociales",
                "Llamada telefónica",
                "Otro"
              ]
            },
            "estado": {
              "type": "string",
              "enum": [
                "potencial",
                "oficial"
              ]
            },
            "medida_interes": {
              "type": "string",
              "enum": [
                "frio",
                "tibio",
                "caliente"
              ]
            },
            "pais": {
              "type": "string"
            },
            "dni": {
              "type": "string",
              "pattern": "^[0-9-]+$"
            },
            "notas": {
              "type": "string"
            }
          },
          "required": [
            "name"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      }
    ]
  }
}
